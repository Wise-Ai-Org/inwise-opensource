{
  "name": "inwise-opensource",
  "version": "1.4.0",
  "description": "Open-source AI meeting recorder — local transcription, local storage, your own API key",
  "license": "MIT",
  "author": "Inwise.ai",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"wait-on dist/main/main.js dist/renderer/bundle.js && electron .\"",
    "build": "npm run build:shared && npm run build:main && npm run build:renderer",
    "build:shared": "tsc -p src/shared/tsconfig.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.renderer.config.js && node scripts/copy-static.js",
    "build:whisper:mac": "node scripts/build-whisper-mac.js",
    "verify:whisper:mac": "node scripts/verify-whisper-mac.js",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "webpack --config webpack.renderer.config.js --watch",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win && node scripts/stable-installer.js",
    "dist:mac": "npm run build:whisper:mac && npm run verify:whisper:mac && npm run build && electron-builder --mac",
    "test": "npm run build:shared && npm run build:main && node scripts/run-tests.js && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/renderer-platform.test.mts"
  },
  "build": {
    "appId": "com.inwise.desktop",
    "productName": "Inwise",
    "directories": {
      "output": "release-v2"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json",
      "!dist/main/**/*.test.js",
      "!dist/main/**/*.test.js.map",
      "!dist/**/*.map",
      "!node_modules/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Inwise-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "binaries": [
        "Contents/Resources/whisper/whisper-cli"
      ],
      "notarize": true,
      "artifactName": "Inwise-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "native/whisper/darwin-${arch}",
          "to": "whisper",
          "filter": [
            "whisper-cli",
            "manifest.json",
            "LICENSE.whisper.cpp"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Inwise uses your microphone to record your voice during meetings for local transcription.",
        "NSAudioCaptureUsageDescription": "Inwise records system audio during meetings so other participants can be transcribed locally.",
        "NSScreenCaptureUsageDescription": "Inwise captures system audio so other meeting participants can be transcribed. No video is recorded.",
        "LSUIElement": false
      }
    },
    "dmg": {
      "sign": false
    },
    "asar": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@inwise/desktop-shared": "file:src/shared",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@seald-io/nedb": "^4.0.4",
    "electron-store": "^8.2.0",
    "framer-motion": "^10.18.0",
    "node-ical": "^0.25.6",
    "onnxruntime-web": "^1.20.1",
    "openai": "^4.67.0",
    "react-icons": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "wait-on": "^7.2.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
